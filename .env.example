# ============================================================================
# STUDYPILOT BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# Application Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=StudyPilot
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

# CORS allowlist (comma-separated) + accepted client identifiers
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000
ALLOWED_CLIENT_IDS=web-app,browser-extension-popup,browser-extension-sidepanel,mobile-client

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://studypilot:studypilot_dev_pass@localhost:5432/studypilot_db?schema=public"
DIRECT_DATABASE_URL="postgresql://studypilot:studypilot_dev_pass@localhost:5432/studypilot_db?schema=public"
# Interactive transaction budget (raise for high-latency managed databases)
DB_TX_MAX_WAIT_MS=15000
DB_TX_TIMEOUT_MS=30000
# Prisma connection pool (keep below the database/pooler max client count)
DB_MAX_CONNECTIONS=8
DB_POOL_TIMEOUT=20

# Redis Cache & BullMQ Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

# JWT, cookies & CSRF (generate long random values in production)
JWT_ACCESS_SECRET=CHANGE_ME_MIN_64_CHAR_RANDOM_HEX_ACCESS_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_MIN_64_CHAR_RANDOM_HEX_REFRESH_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=CHANGE_ME_COOKIE_SIGNING_SECRET
CSRF_SECRET=CHANGE_ME_CSRF_SIGNING_SECRET

# Password Hashing (Argon2id parameters)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_AUTH=10
THROTTLE_LIMIT_AI=20

# S3-Compatible Object Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET_NAME=studypilot-assets
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_FILE_SIZE_BYTES=10485760
PRESIGNED_URL_EXPIRES_SECONDS=900

# SMTP Email Provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
EMAIL_FROM_ADDRESS=CHANGE_ME_SMTP_USER
EMAIL_FROM_NAME=StudyPilot
# Fail fast instead of hanging requests when SMTP is slow/unreachable
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
FRONTEND_SUPPORT_URL=http://localhost:5173

# External AI Provider (Google Gemini + Fallback)
GEMINI_API_KEY=CHANGE_ME_GOOGLE_GEMINI_API_KEY
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
AI_FALLBACK_PROVIDER=openai-compatible
AI_FALLBACK_API_KEY=CHANGE_ME_FALLBACK_API_KEY
AI_FREE_DAILY_TOKEN_LIMIT=25000
AI_PRO_DAILY_TOKEN_LIMIT=500000
AI_PROVIDER_KEY_ENCRYPTION_SECRET=CHANGE_ME_32_BYTE_AES_GCM_KEY

# Payment Gateway & Webhook Security
PAYMENT_PROVIDER=stripe
PAYMENT_API_SECRET_KEY=CHANGE_ME_PAYMENT_SECRET_KEY
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET
