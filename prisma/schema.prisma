// I. AI SYSTEM (5 Tables)
// 1. ai_conversations, 2. ai_messages, 3. ai_usage_logs,
// 4. ai_provider_configs, 5. ai_generation_jobs
// ============================================================================

model AiProviderConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  providerName         String   @unique @map("provider_name") @db.VarChar(64)
  modelName            String   @map("model_name") @db.VarChar(120)
  encryptedApiKeyRef   String   @map("encrypted_api_key_ref") @db.VarChar(255)
  isPrimary            Boolean  @default(false) @map("is_primary")
  isActive             Boolean  @default(true) @map("is_active")
  priorityOrder        Int      @default(1) @map("priority_order")
  maxTokensPerRequest  Int      @default(4096) @map("max_tokens_per_request")
  timeoutMs            Int      @default(30000) @map("timeout_ms")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("ai_provider_configs")
}

model AiConversation {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  subjectId   String?     @map("subject_id") @db.Uuid
  title       String      @db.VarChar(255)
  contextType String      @default("GENERAL_STUDY") @map("context_type") @db.VarChar(64)
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId, createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String         @id @default(uuid()) @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  role             String         @db.VarChar(32)
  content          String         @db.Text
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  totalTokens      Int            @default(0) @map("total_tokens")
  providerUsed     String         @default("google-gemini") @map("provider_used") @db.VarChar(64)
  createdAt        DateTime       @default(now()) @map("created_at")

  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  feature          String   @db.VarChar(64)
  provider         String   @db.VarChar(64)
  model            String   @db.VarChar(120)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  isFallback       Boolean  @default(false) @map("is_fallback")
  isSuccess        Boolean  @default(true) @map("is_success")
  errorCode        String?  @map("error_code") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model AiGenerationJob {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  jobType        String      @map("job_type") @db.VarChar(64)
  status         AiJobStatus @default(QUEUED)
  inputPayload   Json        @map("input_payload")
  outputPayload  Json?       @map("output_payload")
  isValidated    Boolean     @default(false) @map("is_validated")
  errorMessage   String?     @map("error_message") @db.Text
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ai_generation_jobs")
}

// ============================================================================
// J. LEADERBOARD AND REWARDS (9 Tables)
// 1. point_transactions, 2. user_points, 3. leaderboard_snapshots,
// 4. achievements, 5. user_achievements, 6. reward_catalog,
// 7. reward_redemptions, 8. activity_logs, 9. reward_rules
// ============================================================================

model RewardRule {
  id                String   @id @default(uuid()) @db.Uuid
  eventCode         String   @unique @map("event_code") @db.VarChar(80)
  description       String   @db.VarChar(255)
  pointsAwarded     Int      @map("points_awarded")
  maxDailyOccurrences Int    @default(10) @map("max_daily_occurrences")
  cooldownSeconds   Int      @default(60) @map("cooldown_seconds")
  minDurationSeconds Int     @default(0) @map("min_duration_seconds")
  isActive          Boolean  @default(true) @map("is_active")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("reward_rules")
}

model PointTransaction {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  transactionType PointTransactionType @map("transaction_type")
  eventCode       String               @map("event_code") @db.VarChar(80)
  sourceEntityId  String               @map("source_entity_id") @db.VarChar(128)
  idempotencyKey  String               @unique @map("idempotency_key") @db.VarChar(160)
  pointsDelta     Int                  @map("points_delta")
  balanceAfter    Int                  @map("balance_after")
  description     String?              @db.VarChar(255)
  createdAt       DateTime             @default(now()) @map("created_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventCode, sourceEntityId])
  @@map("point_transactions")
}

model UserPoint {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  totalPointsEarned Int      @default(0) @map("total_points_earned")
  currentBalance    Int      @default(0) @map("current_balance")
  totalPointsSpent  Int      @default(0) @map("total_points_spent")
  currentStreakDays Int      @default(0) @map("current_streak_days")
  longestStreakDays Int      @default(0) @map("longest_streak_days")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPointsEarned(sort: Desc)])
  @@map("user_points")
}

model LeaderboardSnapshot {
  id          String            @id @default(uuid()) @db.Uuid
  period      LeaderboardPeriod
  periodStart DateTime          @map("period_start") @db.Date
  periodEnd   DateTime          @map("period_end") @db.Date
  userId      String            @map("user_id") @db.Uuid
  points      Int
  rank        Int
  computedAt  DateTime          @default(now()) @map("computed_at")

  @@unique([period, periodStart, userId])
  @@index([period, periodStart, rank])
  @@map("leaderboard_snapshots")
}

model Achievement {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(80)
  title            String            @db.VarChar(150)
  description      String            @db.VarChar(255)
  icon             String?           @db.VarChar(120)
  criteriaType     String            @map("criteria_type") @db.VarChar(64)
  criteriaValue    Int               @map("criteria_value")
  bonusPoints      Int               @default(0) @map("bonus_points")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  achievementId String      @map("achievement_id") @db.Uuid
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model RewardCatalog {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(180)
  description   String             @db.Text
  pointsCost    Int                @map("points_cost")
  stockQuantity Int                @default(100) @map("stock_quantity")
  category      String             @default("DIGITAL_PERK") @db.VarChar(64)
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  redemptions   RewardRedemption[]

  @@map("reward_catalog")
}

model RewardRedemption {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  rewardId       String           @map("reward_id") @db.Uuid
  pointsSpent    Int              @map("points_spent")
  idempotencyKey String           @unique @map("idempotency_key") @db.VarChar(160)
  status         RedemptionStatus @default(PENDING)
  fulfilledAt    DateTime?        @map("fulfilled_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward         RewardCatalog    @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("reward_redemptions")
}

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  activityType String   @map("activity_type") @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(64)
  entityId     String   @map("entity_id") @db.VarChar(128)
  metadata     Json?
  occurredAt   DateTime @default(now()) @map("occurred_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("activity_logs")
}

// ============================================================================
// K. NOTIFICATION SYSTEM (5 Tables)
// 1. notifications, 2. notification_preferences, 3. notification_templates,
// 4. notification_delivery_logs, 5. user_devices
// ============================================================================

model NotificationTemplate {
  id              String               @id @default(uuid()) @db.Uuid
  code            String               @unique @db.VarChar(80)
  category        NotificationCategory
  subjectTemplate String               @map("subject_template") @db.VarChar(255)
  bodyTemplate    String               @map("body_template") @db.Text
  isActive        Boolean              @default(true) @map("is_active")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model Notification {
  id           String                     @id @default(uuid()) @db.Uuid
  userId       String                     @map("user_id") @db.Uuid
  category     NotificationCategory
  title        String                     @db.VarChar(255)
  body         String                     @db.Text
  actionUrl    String?                    @map("action_url") @db.VarChar(512)
  isRead       Boolean                    @default(false) @map("is_read")
  readAt       DateTime?                  @map("read_at")
  createdAt    DateTime                   @default(now()) @map("created_at")

  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs NotificationDeliveryLog[]

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  category    NotificationCategory
  inAppEnabled Boolean             @default(true) @map("in_app_enabled")
  emailEnabled Boolean             @default(true) @map("email_enabled")
  pushEnabled  Boolean             @default(false) @map("push_enabled")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model NotificationDeliveryLog {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         String              @db.VarChar(32)
  providerRef    String?             @map("provider_ref") @db.VarChar(255)
  errorMessage   String?             @map("error_message") @db.Text
  deliveredAt    DateTime            @default(now()) @map("delivered_at")

  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_logs")
}

model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  clientId    String   @map("client_id") @db.VarChar(64)
  pushToken   String?  @unique @map("push_token") @db.VarChar(512)
  platform    String   @db.VarChar(64)
  isActive    Boolean  @default(true) @map("is_active")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_devices")
}

// ============================================================================
// L. SUBSCRIPTION AND PAYMENT (6 Tables)
// 1. subscription_plans, 2. subscriptions, 3. payment_transactions,
// 4. payment_webhooks, 5. invoices, 6. subscription_usage
// ============================================================================

model SubscriptionPlan {
  id                  String         @id @default(uuid()) @db.Uuid
  code                String         @unique @db.VarChar(64)
  name                String         @db.VarChar(120)
  priceCents          Int            @map("price_cents")
  currency            String         @default("USD") @db.VarChar(8)
  billingInterval     String         @default("MONTHLY") @map("billing_interval") @db.VarChar(32)
  dailyAiTokenLimit   Int            @map("daily_ai_token_limit")
  storageQuotaBytes   BigInt         @map("storage_quota_bytes")
  features            Json
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")

  subscriptions       Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(ACTIVE)
  externalSubscriptionId String?          @unique @map("external_subscription_id") @db.VarChar(160)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt          DateTime?          @map("cancelled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageRecords         SubscriptionUsage[]
  invoices             Invoice[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model PaymentTransaction {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  subscriptionId        String?       @map("subscription_id") @db.Uuid
  provider              String        @default("stripe") @db.VarChar(32)
  providerPaymentId     String        @unique @map("provider_payment_id") @db.VarChar(160)
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(160)
  amountCents           Int           @map("amount_cents")
  currency              String        @default("USD") @db.VarChar(8)
  status                PaymentStatus @default(PENDING)
  refundedAmountCents   Int           @default(0) @map("refunded_amount_cents")
  verifiedAt            DateTime?     @map("verified_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payment_transactions")
}

model PaymentWebhook {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @db.VarChar(32)
  providerEventId   String   @unique @map("provider_event_id") @db.VarChar(160)
  eventType         String   @map("event_type") @db.VarChar(120)
  signatureVerified Boolean  @default(false) @map("signature_verified")
  payload           Json
  processedAt       DateTime @default(now()) @map("processed_at")
  processingStatus  String   @default("PROCESSED") @map("processing_status") @db.VarChar(32)

  @@index([provider, eventType])
  @@map("payment_webhooks")
}

model Invoice {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  subscriptionId  String       @map("subscription_id") @db.Uuid
  invoiceNumber   String       @unique @map("invoice_number") @db.VarChar(64)
  amountDueCents  Int          @map("amount_due_cents")
  amountPaidCents Int          @map("amount_paid_cents")
  status          String       @default("PAID") @db.VarChar(32)
  issuedAt        DateTime     @default(now()) @map("issued_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invoices")
}

model SubscriptionUsage {
  id                String       @id @default(uuid()) @db.Uuid
  subscriptionId    String       @map("subscription_id") @db.Uuid
  usageDate         DateTime     @map("usage_date") @db.Date
  aiTokensUsed      Int          @default(0) @map("ai_tokens_used")
  storageBytesUsed  BigInt       @default(0) @map("storage_bytes_used")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, usageDate])
  @@map("subscription_usage")
}

// ============================================================================
// M. ADMINISTRATION AND AUDIT (7 Tables)
// 1. admin_actions, 2. audit_logs, 3. system_settings, 4. feature_flags,
// 5. announcements, 6. support_tickets, 7. support_messages
// ============================================================================

model AdminAction {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  actionType   String   @map("action_type") @db.VarChar(80)
  targetType   String   @map("target_type") @db.VarChar(64)
  targetId     String   @map("target_id") @db.VarChar(128)
  reason       String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  adminUser    User     @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@map("admin_actions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role") @db.VarChar(32)
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.Text
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  value       Json
  description String?  @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model FeatureFlag {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique @db.VarChar(120)
  isEnabled         Boolean  @default(false) @map("is_enabled")
  rolloutPercentage Int      @default(100) @map("rollout_percentage")
  description       String?  @db.VarChar(255)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  body        String    @db.Text
  targetRole  RoleName? @map("target_role")
  isActive    Boolean   @default(true) @map("is_active")
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([isActive, publishedAt])
  @@map("announcements")
}

model SupportTicket {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  subject     String           @db.VarChar(255)
  category    String           @default("GENERAL") @db.VarChar(64)
  priority    PriorityLevel    @default(MEDIUM)
  status      TicketStatus     @default(OPEN)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  senderId    String        @map("sender_id") @db.Uuid
  isStaffReply Boolean      @default(false) @map("is_staff_reply")
  messageBody String        @map("message_body") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
