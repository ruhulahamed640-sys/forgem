// ============================================================================
// STUDYPILOT — COMPLETE NORMALIZED POSTGRESQL PRISMA SCHEMA
// Covers all 13 Database Modules (Sections 4A–4M, 82 normalized tables)
// Primary keys: UUID v4 | Timestamps: UTC | Strict Referential Integrity
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------
enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum RoleName {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  OVERDUE
  GRADED
}

enum ExamStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum PlanPeriodType {
  DAILY
  WEEKLY
  CUSTOM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
}

enum SpacedRepetitionAlgorithm {
  SM2
  LEITNER
  FSRS_LIGHT
  CUSTOM_INTERVALS
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  INVALIDATED
}

enum StudySessionEventType {
  START
  PAUSE
  RESUME
  COMPLETE
  HEARTBEAT
  ABORT
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum PointTransactionType {
  EARNED
  REDEEMED
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum RedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationCategory {
  ASSIGNMENT_REMINDER
  EXAM_REMINDER
  REVISION_REMINDER
  STUDY_PLAN_REMINDER
  ACHIEVEMENT
  REWARD
  SECURITY
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================================================
// A. USER AND AUTHENTICATION (12 Tables)
// 1. users, 2. user_profiles, 3. user_settings, 4. user_sessions,
// 5. refresh_tokens, 6. email_verifications, 7. password_resets,
// 8. login_attempts, 9. user_roles, 10. roles, 11. permissions, 12. role_permissions
// ============================================================================

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique @db.VarChar(255)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  status              AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  lastLoginAt         DateTime?     @map("last_login_at")
  suspendedAt         DateTime?     @map("suspended_at")
  suspensionReason    String?       @map("suspension_reason")
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  profile             UserProfile?
  settings            UserSetting?
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  loginAttempts       LoginAttempt[]
  userRoles           UserRole[]
  subjectEnrollments  SubjectEnrollment[]
  subjectProgress     StudentSubjectProgress[]
  topicProgress       StudentTopicProgress[]
  academicGrades      AcademicGrade[]
  assignments         Assignment[]
  submissions         AssignmentSubmission[]
  assignmentComments  AssignmentComment[]
  exams               Exam[]
  examResults         ExamResult[]
  studyPlans          StudyPlan[]
  studyGoals          StudyGoal[]
  studyRoutines       StudyRoutine[]
  dailyEntries        DailyPlannerEntry[]
  revisionSchedules   RevisionSchedule[]
  revisionSessions    RevisionSession[]
  studySessions       StudySession[]
  studyStatistics     StudyStatistic[]
  notes               Note[]
  noteFolders         NoteFolder[]
  savedResources      SavedResource[]
  aiConversations     AiConversation[]
  aiUsageLogs         AiUsageLog[]
  aiGenerationJobs    AiGenerationJob[]
  pointTransactions   PointTransaction[]
  userPoints          UserPoint?
  userAchievements    UserAchievement[]
  rewardRedemptions   RewardRedemption[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  userDevices         UserDevice[]
  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]
  invoices            Invoice[]
  adminActions        AdminAction[]         @relation("AdminActor")
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  displayName     String?   @map("display_name") @db.VarChar(120)
  avatarStorageKey String?  @map("avatar_storage_key") @db.VarChar(512)
  bio             String?   @db.Text
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  phone           String?   @db.VarChar(32)
  institutionId   String?   @map("institution_id") @db.Uuid
  classId         String?   @map("class_id") @db.Uuid
  academicYearId  String?   @map("academic_year_id") @db.Uuid
  timezone        String    @default("UTC") @db.VarChar(64)
  locale          String    @default("en-US") @db.VarChar(16)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  academicClass   AcademicClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([academicYearId])
  @@map("user_profiles")
}

model UserSetting {
  id                        String                    @id @default(uuid()) @db.Uuid
  userId                    String                    @unique @map("user_id") @db.Uuid
  dailyStudyTargetMinutes   Int                       @default(120) @map("daily_study_target_minutes")
  weeklyStudyTargetMinutes  Int                       @default(840) @map("weekly_study_target_minutes")
  pomodoroWorkMinutes       Int                       @default(25) @map("pomodoro_work_minutes")
  pomodoroBreakMinutes      Int                       @default(5) @map("pomodoro_break_minutes")
  spacedRepetitionAlgorithm SpacedRepetitionAlgorithm @default(SM2) @map("spaced_repetition_algorithm")
  customRevisionIntervals   Json?                     @map("custom_revision_intervals")
  leaderboardOptIn          Boolean                   @default(true) @map("leaderboard_opt_in")
  extensionSyncEnabled      Boolean                   @default(true) @map("extension_sync_enabled")
  aiAssistanceEnabled       Boolean                   @default(true) @map("ai_assistance_enabled")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")

  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  clientId     String    @default("web-app") @map("client_id") @db.VarChar(64)
  deviceName   String?   @map("device_name") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.Text
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  tokenFamily       String    @map("token_family") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  isRevoked         Boolean   @default(false) @map("is_revoked")
  revokedAt         DateTime? @map("revoked_at")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([sessionId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String   @db.VarChar(255)
  ipAddress     String   @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.Text
  clientId      String   @default("web-app") @map("client_id") @db.VarChar(64)
  isSuccessful  Boolean  @map("is_successful")
  failureReason String?  @map("failure_reason") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            RoleName         @unique
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(120)
  module          String           @db.VarChar(64)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// ============================================================================
// B. ACADEMIC MANAGEMENT (10 Tables)
// 1. academic_years, 2. institutions, 3. classes, 4. subjects,
// 5. subject_enrollments, 6. chapters, 7. topics,
// 8. student_subject_progress, 9. student_topic_progress, 10. academic_grades
// ============================================================================

model AcademicYear {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique @db.VarChar(100)
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  isCurrent   Boolean       @default(false) @map("is_current")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  profiles    UserProfile[]
  subjects    Subject[]
  enrollments SubjectEnrollment[]
  grades      AcademicGrade[]

  @@map("academic_years")
}

model Institution {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(255)
  code      String          @unique @db.VarChar(64)
  type      String          @default("UNIVERSITY") @db.VarChar(64)
  country   String?         @db.VarChar(64)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  classes   AcademicClass[]
  profiles  UserProfile[]

  @@map("institutions")
}

model AcademicClass {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String?       @map("institution_id") @db.Uuid
  name          String        @db.VarChar(120)
  gradeLevel    String        @map("grade_level") @db.VarChar(64)
  section       String?       @db.VarChar(32)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  institution   Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  profiles      UserProfile[]
  subjects      Subject[]

  @@index([institutionId])
  @@map("classes")
}

model Subject {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  academicYearId      String?                  @map("academic_year_id") @db.Uuid
  classId             String?                  @map("class_id") @db.Uuid
  name                String                   @db.VarChar(150)
  code                String?                  @db.VarChar(40)
  colorHex            String                   @default("#4F46E5") @map("color_hex") @db.VarChar(16)
  icon                String?                  @db.VarChar(64)
  targetWeeklyMinutes Int                      @default(180) @map("target_weekly_minutes")
  isArchived          Boolean                  @default(false) @map("is_archived")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  academicYear        AcademicYear?            @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  academicClass       AcademicClass?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  enrollments         SubjectEnrollment[]
  chapters            Chapter[]
  subjectProgress     StudentSubjectProgress[]
  grades              AcademicGrade[]
  assignments         Assignment[]
  assignmentSubjects  AssignmentSubject[]
  examSubjects        ExamSubject[]
  studyPlanTasks      StudyPlanTask[]
  studySessions       StudySession[]
  notes               Note[]

  @@unique([userId, name, academicYearId])
  @@index([userId, isArchived])
  @@map("subjects")
}

model SubjectEnrollment {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  enrolledAt     DateTime     @default(now()) @map("enrolled_at")
  isActive       Boolean      @default(true) @map("is_active")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, academicYearId])
  @@index([userId])
  @@map("subject_enrollments")
}

model Chapter {
  id               String   @id @default(uuid()) @db.Uuid
  subjectId        String   @map("subject_id") @db.Uuid
  title            String   @db.VarChar(200)
  orderIndex       Int      @default(1) @map("order_index")
  description      String?  @db.Text
  estimatedMinutes Int      @default(60) @map("estimated_minutes")
  isCompleted      Boolean  @default(false) @map("is_completed")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics           Topic[]

  @@unique([subjectId, orderIndex])
  @@index([subjectId])
  @@map("chapters")
}

model Topic {
  id               String                 @id @default(uuid()) @db.Uuid
  chapterId        String                 @map("chapter_id") @db.Uuid
  title            String                 @db.VarChar(200)
  orderIndex       Int                    @default(1) @map("order_index")
  contentSummary   String?                @map("content_summary") @db.Text
  difficultyLevel  Int                    @default(3) @map("difficulty_level")
  estimatedMinutes Int                    @default(30) @map("estimated_minutes")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  chapter          Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicProgress    StudentTopicProgress[]
  revisionTopics   RevisionTopic[]
  studySessions    StudySession[]

  @@unique([chapterId, orderIndex])
  @@index([chapterId])
  @@map("topics")
}

model StudentSubjectProgress {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  subjectId            String   @map("subject_id") @db.Uuid
  totalChapters        Int      @default(0) @map("total_chapters")
  completedChapters    Int      @default(0) @map("completed_chapters")
  totalTopics          Int      @default(0) @map("total_topics")
  completedTopics      Int      @default(0) @map("completed_topics")
  completionPercentage Decimal  @default(0) @map("completion_percentage") @db.Decimal(5, 2)
  totalStudyMinutes    Int      @default(0) @map("total_study_minutes")
  lastStudiedAt        DateTime? @map("last_studied_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@map("student_subject_progress")
}

model StudentTopicProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  topicId              String    @map("topic_id") @db.Uuid
  isCompleted          Boolean   @default(false) @map("is_completed")
  completionPercentage Decimal   @default(0) @map("completion_percentage") @db.Decimal(5, 2)
  confidenceScore      Int       @default(3) @map("confidence_score")
  timeSpentMinutes     Int       @default(0) @map("time_spent_minutes")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic                Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@map("student_topic_progress")
}

model AcademicGrade {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  termName       String       @map("term_name") @db.VarChar(80)
  scoreObtained  Decimal      @map("score_obtained") @db.Decimal(6, 2)
  maxScore       Decimal      @map("max_score") @db.Decimal(6, 2)
  percentage     Decimal      @db.Decimal(5, 2)
  letterGrade    String       @map("letter_grade") @db.VarChar(8)
  gradePoints    Decimal?     @map("grade_points") @db.Decimal(4, 2)
  remarks        String?      @db.Text
  recordedAt     DateTime     @default(now()) @map("recorded_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([userId, academicYearId])
  @@map("academic_grades")
}

// ============================================================================
// C. ASSIGNMENT MANAGEMENT (6 Tables)
// 1. assignments, 2. assignment_subjects, 3. assignment_attachments,
// 4. assignment_submissions, 5. assignment_comments, 6. assignment_reminders
// ============================================================================

model Assignment {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  subjectId            String           @map("subject_id") @db.Uuid
  title                String           @db.VarChar(255)
  description          String?          @db.Text
  deadline             DateTime
  priority             PriorityLevel    @default(MEDIUM)
  status               AssignmentStatus @default(PENDING)
  completionPercentage Int              @default(0) @map("completion_percentage")
  submittedAt          DateTime?        @map("submitted_at")
  completedAt          DateTime?        @map("completed_at")
  teacherFeedback      String?          @map("teacher_feedback") @db.Text
  isOverdue            Boolean          @default(false) @map("is_overdue")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignmentSubjects   AssignmentSubject[]
  attachments          AssignmentAttachment[]
  submissions          AssignmentSubmission[]
  comments             AssignmentComment[]
  reminders            AssignmentReminder[]

  @@index([userId, status])
  @@index([userId, deadline])
  @@index([subjectId])
  @@map("assignments")
}

model AssignmentSubject {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  subjectId    String     @map("subject_id") @db.Uuid
  isPrimary    Boolean    @default(false) @map("is_primary")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, subjectId])
  @@map("assignment_subjects")
}

model AssignmentAttachment {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  uploadedById String     @map("uploaded_by_id") @db.Uuid
  fileName     String     @map("file_name") @db.VarChar(255)
  mimeType     String     @map("mime_type") @db.VarChar(120)
  fileSizeBytes Int       @map("file_size_bytes")
  storageKey   String     @unique @map("storage_key") @db.VarChar(512)
  createdAt    DateTime   @default(now()) @map("created_at")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_attachments")
}

model AssignmentSubmission {
  id              String     @id @default(uuid()) @db.Uuid
  assignmentId    String     @map("assignment_id") @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  notes           String?    @db.Text
  attachmentKeys  Json?      @map("attachment_keys")
  submittedAt     DateTime   @default(now()) @map("submitted_at")
  scoreObtained   Decimal?   @map("score_obtained") @db.Decimal(6, 2)
  maxScore        Decimal?   @map("max_score") @db.Decimal(6, 2)
  teacherFeedback String?    @map("teacher_feedback") @db.Text

  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId, userId])
  @@map("assignment_submissions")
}

model AssignmentComment {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  authorRole   RoleName   @default(STUDENT) @map("author_role")
  body         String     @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_comments")
}

model AssignmentReminder {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  remindAt     DateTime   @map("remind_at")
  channel      NotificationChannel @default(IN_APP)
  isSent       Boolean    @default(false) @map("is_sent")
  sentAt       DateTime?  @map("sent_at")
  jobId        String?    @map("job_id") @db.VarChar(128)
  createdAt    DateTime   @default(now()) @map("created_at")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([remindAt, isSent])
  @@map("assignment_reminders")
}

// ============================================================================
// D. EXAMINATION MANAGEMENT (6 Tables)
// 1. exams, 2. exam_subjects, 3. exam_schedules, 4. exam_results,
// 5. exam_marks, 6. exam_reminders
// ============================================================================

model Exam {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  title               String         @db.VarChar(255)
  examType            String         @default("MIDTERM") @map("exam_type") @db.VarChar(64)
  description         String?        @db.Text
  startDate           DateTime       @map("start_date")
  endDate             DateTime       @map("end_date")
  status              ExamStatus     @default(UPCOMING)
  preparationProgress Decimal        @default(0) @map("preparation_progress") @db.Decimal(5, 2)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  examSubjects        ExamSubject[]
  schedules           ExamSchedule[]
  results             ExamResult[]
  reminders           ExamReminder[]

  @@index([userId, startDate])
  @@index([userId, status])
  @@map("exams")
}

model ExamSubject {
  id                  String       @id @default(uuid()) @db.Uuid
  examId              String       @map("exam_id") @db.Uuid
  subjectId           String       @map("subject_id") @db.Uuid
  maxMarks            Decimal      @default(100) @map("max_marks") @db.Decimal(6, 2)
  passingMarks        Decimal      @default(40) @map("passing_marks") @db.Decimal(6, 2)
  syllabusChapters    Json?        @map("syllabus_chapters")
  preparationProgress Decimal      @default(0) @map("preparation_progress") @db.Decimal(5, 2)

  exam                Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject             Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schedules           ExamSchedule[]
  examMarks           ExamMark[]

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model ExamSchedule {
  id              String      @id @default(uuid()) @db.Uuid
  examId          String      @map("exam_id") @db.Uuid
  examSubjectId   String      @map("exam_subject_id") @db.Uuid
  examDate        DateTime    @map("exam_date")
  durationMinutes Int         @default(120) @map("duration_minutes")
  roomOrVenue     String?     @map("room_or_venue") @db.VarChar(120)
  notes           String?     @db.Text

  exam            Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject     ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@index([examId, examDate])
  @@map("exam_schedules")
}

model ExamResult {
  id                 String     @id @default(uuid()) @db.Uuid
  examId             String     @map("exam_id") @db.Uuid
  userId             String     @map("user_id") @db.Uuid
  totalMarksObtained Decimal    @map("total_marks_obtained") @db.Decimal(7, 2)
  totalMaxMarks      Decimal    @map("total_max_marks") @db.Decimal(7, 2)
  percentage         Decimal    @db.Decimal(5, 2)
  overallGrade       String     @map("overall_grade") @db.VarChar(12)
  rank               Int?
  remarks            String?    @db.Text
  publishedAt        DateTime   @default(now()) @map("published_at")

  exam               Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  marks              ExamMark[]

  @@unique([examId, userId])
  @@index([userId])
  @@map("exam_results")
}

model ExamMark {
  id            String      @id @default(uuid()) @db.Uuid
  examResultId  String      @map("exam_result_id") @db.Uuid
  examSubjectId String      @map("exam_subject_id") @db.Uuid
  marksObtained Decimal     @map("marks_obtained") @db.Decimal(6, 2)
  maxMarks      Decimal     @map("max_marks") @db.Decimal(6, 2)
  percentage    Decimal     @db.Decimal(5, 2)
  grade         String      @db.VarChar(12)
  remarks       String?     @db.Text

  examResult    ExamResult  @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examResultId, examSubjectId])
  @@map("exam_marks")
}

model ExamReminder {
  id        String              @id @default(uuid()) @db.Uuid
  examId    String              @map("exam_id") @db.Uuid
  remindAt  DateTime            @map("remind_at")
  channel   NotificationChannel @default(IN_APP)
  isSent    Boolean             @default(false) @map("is_sent")
  sentAt    DateTime?           @map("sent_at")
  jobId     String?             @map("job_id") @db.VarChar(128)
  createdAt DateTime            @default(now()) @map("created_at")

  exam      Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([remindAt, isSent])
  @@map("exam_reminders")
}

// ============================================================================
// E. STUDY PLANNER (6 Tables)
// 1. study_plans, 2. study_plan_tasks, 3. study_goals,
// 4. study_routines, 5. study_routine_items, 6. daily_planner_entries
// ============================================================================

model StudyPlan {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  title                String          @db.VarChar(255)
  description          String?         @db.Text
  periodType           PlanPeriodType  @default(WEEKLY) @map("period_type")
  startDate            DateTime        @map("start_date") @db.Date
  endDate              DateTime        @map("end_date") @db.Date
  targetMinutes        Int             @default(600) @map("target_minutes")
  completedMinutes     Int             @default(0) @map("completed_minutes")
  completionPercentage Decimal         @default(0) @map("completion_percentage") @db.Decimal(5, 2)
  isAiGenerated        Boolean         @default(false) @map("is_ai_generated")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks                StudyPlanTask[]

  @@index([userId, startDate, endDate])
  @@map("study_plans")
}

model StudyPlanTask {
  id                  String        @id @default(uuid()) @db.Uuid
  studyPlanId         String        @map("study_plan_id") @db.Uuid
  subjectId           String?       @map("subject_id") @db.Uuid
  title               String        @db.VarChar(255)
  description         String?       @db.Text
  scheduledDate       DateTime      @map("scheduled_date")
  durationMinutes     Int           @default(45) @map("duration_minutes")
  priority            PriorityLevel @default(MEDIUM)
  status              TaskStatus    @default(PENDING)
  rescheduledFromDate DateTime?     @map("rescheduled_from_date")
  completedAt         DateTime?     @map("completed_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  studyPlan           StudyPlan     @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject             Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studyPlanId, scheduledDate])
  @@index([status])
  @@map("study_plan_tasks")
}

model StudyGoal {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  title        String    @db.VarChar(255)
  metricType   String    @default("STUDY_MINUTES") @map("metric_type") @db.VarChar(64)
  targetValue  Int       @map("target_value")
  currentValue Int       @default(0) @map("current_value")
  deadline     DateTime  @db.Date
  isAchieved   Boolean   @default(false) @map("is_achieved")
  achievedAt   DateTime? @map("achieved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isAchieved])
  @@map("study_goals")
}

model StudyRoutine {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String             @db.VarChar(150)
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     StudyRoutineItem[]

  @@index([userId])
  @@map("study_routines")
}

model StudyRoutineItem {
  id           String       @id @default(uuid()) @db.Uuid
  routineId    String       @map("routine_id") @db.Uuid
  dayOfWeek    Int          @map("day_of_week")
  startTime    String       @map("start_time") @db.VarChar(8)
  endTime      String       @map("end_time") @db.VarChar(8)
  subjectId    String?      @map("subject_id") @db.Uuid
  activityTitle String      @map("activity_title") @db.VarChar(180)

  routine      StudyRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, dayOfWeek])
  @@map("study_routine_items")
}

model DailyPlannerEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  planDate            DateTime @map("plan_date") @db.Date
  focusSummary        String?  @map("focus_summary") @db.VarChar(255)
  plannedMinutes      Int      @default(0) @map("planned_minutes")
  actualMinutes       Int      @default(0) @map("actual_minutes")
  completedTasksCount Int      @default(0) @map("completed_tasks_count")
  missedTasksCount    Int      @default(0) @map("missed_tasks_count")
  reflectionNotes     String?  @map("reflection_notes") @db.Text
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planDate])
  @@map("daily_planner_entries")
}

// ============================================================================
// F. REVISION MANAGEMENT (4 Tables)
// 1. revision_schedules, 2. revision_sessions, 3. revision_history, 4. revision_topics
// ============================================================================

model RevisionSchedule {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  revisionTopicId   String                    @map("revision_topic_id") @db.Uuid
  algorithm         SpacedRepetitionAlgorithm @default(SM2)
  repetitionNumber  Int                       @default(0) @map("repetition_number")
  easinessFactor    Decimal                   @default(2.50) @map("easiness_factor") @db.Decimal(4, 2)
  intervalDays      Int                       @default(1) @map("interval_days")
  scheduledFor      DateTime                  @map("scheduled_for")
  nextRevisionDate  DateTime?                 @map("next_revision_date")
  status            TaskStatus                @default(PENDING)
  completedAt       DateTime?                 @map("completed_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisionTopic     RevisionTopic             @relation(fields: [revisionTopicId], references: [id], onDelete: Cascade)
  sessions          RevisionSession[]
  history           RevisionHistory[]

  @@index([userId, scheduledFor, status])
  @@map("revision_schedules")
}

model RevisionTopic {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  topicId        String             @map("topic_id") @db.Uuid
  masteryLevel   Int                @default(1) @map("mastery_level")
  lastReviewedAt DateTime?          @map("last_reviewed_at")
  totalReviews   Int                @default(0) @map("total_reviews")
  createdAt      DateTime           @default(now()) @map("created_at")

  topic          Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  schedules      RevisionSchedule[]

  @@unique([userId, topicId])
  @@map("revision_topics")
}

model RevisionSession {
  id                 String           @id @default(uuid()) @db.Uuid
  revisionScheduleId String           @map("revision_schedule_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  durationMinutes    Int              @map("duration_minutes")
  difficultyRating   Int              @map("difficulty_rating")
  recallScore        Int              @default(4) @map("recall_score")
  notes              String?          @db.Text
  completedAt        DateTime         @default(now()) @map("completed_at")

  schedule           RevisionSchedule @relation(fields: [revisionScheduleId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("revision_sessions")
}

model RevisionHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  revisionScheduleId String           @map("revision_schedule_id") @db.Uuid
  previousInterval   Int              @map("previous_interval")
  newInterval        Int              @map("new_interval")
  previousEasiness   Decimal          @map("previous_easiness") @db.Decimal(4, 2)
  newEasiness        Decimal          @map("new_easiness") @db.Decimal(4, 2)
  difficultyRating   Int              @map("difficulty_rating")
  nextRevisionDate   DateTime         @map("next_revision_date")
  recordedAt         DateTime         @default(now()) @map("recorded_at")

  schedule           RevisionSchedule @relation(fields: [revisionScheduleId], references: [id], onDelete: Cascade)

  @@index([revisionScheduleId])
  @@map("revision_history")
}

// ============================================================================
// G. STUDY SESSION TRACKING (4 Tables)
// 1. study_sessions, 2. study_session_events, 3. study_session_breaks, 4. study_statistics
// ============================================================================

model StudySession {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  subjectId           String?             @map("subject_id") @db.Uuid
  topicId             String?             @map("topic_id") @db.Uuid
  clientId            String              @default("web-app") @map("client_id") @db.VarChar(64)
  status              StudySessionStatus  @default(ACTIVE)
  startTime           DateTime            @default(now()) @map("start_time")
  endTime             DateTime?           @map("end_time")
  actualDurationSeconds Int               @default(0) @map("actual_duration_seconds")
  totalBreakSeconds   Int                 @default(0) @map("total_break_seconds")
  completedTasksCount Int                 @default(0) @map("completed_tasks_count")
  notes               String?             @db.Text
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject             Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic               Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  events              StudySessionEvent[]
  breaks              StudySessionBreak[]

  @@index([userId, status])
  @@index([userId, startTime])
  @@map("study_sessions")
}

model StudySessionEvent {
  id             String                @id @default(uuid()) @db.Uuid
  studySessionId String                @map("study_session_id") @db.Uuid
  eventType      StudySessionEventType @map("event_type")
  serverTime     DateTime              @default(now()) @map("server_time")
  metadata       Json?

  studySession   StudySession          @relation(fields: [studySessionId], references: [id], onDelete: Cascade)

  @@index([studySessionId, serverTime])
  @@map("study_session_events")
}

model StudySessionBreak {
  id              String       @id @default(uuid()) @db.Uuid
  studySessionId  String       @map("study_session_id") @db.Uuid
  breakStart      DateTime     @default(now()) @map("break_start")
  breakEnd        DateTime?    @map("break_end")
  durationSeconds Int          @default(0) @map("duration_seconds")

  studySession    StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)

  @@index([studySessionId])
  @@map("study_session_breaks")
}

model StudyStatistic {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  statDate            DateTime @map("stat_date") @db.Date
  totalStudySeconds   Int      @default(0) @map("total_study_seconds")
  totalBreakSeconds   Int      @default(0) @map("total_break_seconds")
  sessionsCompleted   Int      @default(0) @map("sessions_completed")
  tasksCompleted      Int      @default(0) @map("tasks_completed")
  streakDays          Int      @default(0) @map("streak_days")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, statDate])
  @@index([userId, statDate])
  @@map("study_statistics")
}

// ============================================================================
// H. RESOURCES AND NOTES (5 Tables)
// 1. notes, 2. note_folders, 3. saved_resources,
// 4. resource_categories, 5. resource_attachments
// ============================================================================

model NoteFolder {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(150)
  parentId  String?  @map("parent_id") @db.Uuid
  colorHex  String   @default("#6366F1") @map("color_hex") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@unique([userId, name])
  @@index([userId])
  @@map("note_folders")
}

model Note {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  folderId   String?     @map("folder_id") @db.Uuid
  subjectId  String?     @map("subject_id") @db.Uuid
  title      String      @db.VarChar(255)
  content    String      @db.Text
  tags       String[]
  isPinned   Boolean     @default(false) @map("is_pinned")
  isArchived Boolean     @default(false) @map("is_archived")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, isArchived])
  @@index([subjectId])
  @@map("notes")
}

model ResourceCategory {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique @db.VarChar(120)
  slug        String          @unique @db.VarChar(120)
  description String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at")

  resources   SavedResource[]

  @@map("resource_categories")
}

model SavedResource {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  categoryId   String?              @map("category_id") @db.Uuid
  title        String               @db.VarChar(255)
  url          String?              @db.Text
  description  String?              @db.Text
  isBookmarked Boolean              @default(true) @map("is_bookmarked")
  tags         String[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     ResourceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments  ResourceAttachment[]

  @@index([userId, isBookmarked])
  @@map("saved_resources")
}

model ResourceAttachment {
  id            String        @id @default(uuid()) @db.Uuid
  resourceId    String        @map("resource_id") @db.Uuid
  uploadedById  String        @map("uploaded_by_id") @db.Uuid
  fileName      String        @map("file_name") @db.VarChar(255)
  mimeType      String        @map("mime_type") @db.VarChar(120)
  fileSizeBytes Int           @map("file_size_bytes")
  storageKey    String        @unique @map("storage_key") @db.VarChar(512)
  checksumSha256 String?      @map("checksum_sha256") @db.VarChar(64)
  createdAt     DateTime      @default(now()) @map("created_at")

  resource      SavedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_attachments")
}

